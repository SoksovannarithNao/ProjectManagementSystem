# Copy to .env and adjust if needed:
#   cp .env.example .env
# Used by docker-compose.yml to configure the full stack (postgres, backend, frontend).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskmanager
POSTGRES_PORT=5432

# Backend's own least-privileged database login (database/init/03-app-role.sh)
# — separate from the POSTGRES_USER/PASSWORD superuser above, which is only
# used for container initialization. Change this in every real deployment.
TASKMANAGER_APP_PASSWORD=taskmanager_app_password

# HMAC signing key for JWTs — change this in every real deployment (see
# docs/backend.md's Security section). All existing tokens are invalidated
# when this value changes.
JWT_SECRET=change-this-development-secret-key-change-this-development-secret-key
# Sign-in session: the access token lives 15 minutes (ms) and is renewed from a refresh cookie that
# lasts 7 days (ms). Set REFRESH_COOKIE_SECURE=true when the site is served over HTTPS.
JWT_EXPIRATION_MS=900000
REFRESH_EXPIRATION_MS=604800000
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

BACKEND_PORT=8080
FRONTEND_PORT=5173

# A registration nobody verifies is deleted after this many hours; the cleanup runs at the start of
# every hour (cron with seconds). Both are optional.
PENDING_REGISTRATION_TTL_HOURS=24
PENDING_REGISTRATION_CLEANUP_CRON=0 0 * * * *

# Registration OTP emails. Defaults to the local Mailpit container in
# docker-compose.yml (an SMTP catcher — nothing actually leaves the
# machine; view "sent" mail at http://localhost:8025). Point these at a
# real SMTP provider instead for anything beyond local dev.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@taskflow.dev
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
